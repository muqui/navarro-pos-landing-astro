---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sistema de Reparaciones para Talleres de Celulares | Navarro POS"
  description="Administra órdenes de reparación, estados, costos y ganancias con el módulo de reparaciones de Navarro POS."
>
  <main class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-4xl font-bold mb-6">
        Sistema de Reparaciones para Talleres de Celulares
      </h1>

      <p class="text-lg text-gray-600 mb-8">
        Lleva el control completo de reparaciones, desde la recepción hasta la entrega.
      </p>

      <h2 class="text-2xl font-bold mt-10 mb-4">
        Funciones del módulo de reparaciones
      </h2>

      <ul class="space-y-3">
        <li>✔ Registro de órdenes de reparación</li>
        <li>✔ Estados: en revisión, en reparación, listo</li>
        <li>✔ Control de costos y ganancias</li>
        <li>✔ Historial por cliente</li>
        <li>✔ Filtros por fecha</li>
      </ul>
    </div>
  </main>
</BaseLayout>
