<nav class="fixed w-full z-50 transition-colors duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="text-xl font-bold text-white">Navarro POS</a>

    <!-- Botón hamburguesa móvil -->
    <button
      class="md:hidden text-white focus:outline-none"
      id="menu-button"
      aria-label="Abrir menú"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Menu desktop -->
    <ul class="hidden md:flex gap-6 font-medium" id="menu">
      <li><a href="/" class="text-white hover:text-blue-300 transition">Inicio</a></li>
      <li><a href="/reparaciones" class="text-white hover:text-blue-300 transition">Reparaciones</a></li>
    </ul>
  </div>

  <!-- Menu móvil -->
  <ul class="flex flex-col gap-4 p-4 md:hidden bg-blue-700/95 hidden" id="mobile-menu">
    <li><a href="/" class="text-white hover:text-blue-300 transition">Inicio</a></li>
    <li><a href="/reparaciones" class="text-white hover:text-blue-300 transition">Reparaciones</a></li>
  </ul>
</nav>

<script type="text/javascript">
  const btn = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');

  // Toggle menú móvil
  btn.addEventListener('click', () => {
    menu.classList.toggle('hidden');
  });

  // Cambio de color al hacer scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar.classList.add('bg-blue-800', 'shadow-lg');
      navbar.classList.remove('bg-transparent');
    } else {
      navbar.classList.remove('bg-blue-800', 'shadow-lg');
      navbar.classList.add('bg-transparent');
    }
  });
</script>
